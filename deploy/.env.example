# BranBoos — environment template
# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file — it is in .gitignore.

# ── Domain & TLS ────────────────────────────────────────────────────
BASE_DOMAIN=customer-domain.com
TRAEFIK_ACME_EMAIL=ops@branboos.com

# ── AI Gateway ────────────────────────────────────────────────────
# Only the AI Gateway's container ever reads these keys.
# Provided by BranBoos or by the customer per deployment agreement.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=         # optional — the AI Gateway falls back to Claude if set

# Shared internal secret between AI Chatbot/Vendor Manager and the AI Gateway.
# Generate with: openssl rand -hex 32
KEYSTONE_SERVICE_TOKEN=

# ── CRM ────────────────────────────────────────────────────────────
# Token used by the AI Chatbot to write qualified leads into the CRM.
CRM_API_TOKEN=
CRM_DB_ROOT_PASSWORD=
CRM_DB_NAME=crm

# ── ERP ──────────────────────────────────────────────────────────────
# Token used by Vendor Manager to read vendor data and write POs into the ERP.
ERP_API_TOKEN=
ERP_DB_ROOT_PASSWORD=
ERP_DB_NAME=erp
