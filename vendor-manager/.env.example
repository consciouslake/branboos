# vendor-manager/.env.example
# Copy to .env for local (non-Docker) development.
# In docker-compose, these are injected via deploy/.env instead.

PORT=4001

# Internal AI gateway — never a provider key directly.
KEYSTONE_URL=http://localhost:8001
KEYSTONE_SERVICE_TOKEN=

# ERP — for reading vendor data and writing purchase orders.
ERP_API_URL=
# Frappe REST auth token, in "api_key:api_secret" form — sent as
# `Authorization: token <ERP_API_TOKEN>`.
ERP_API_TOKEN=
